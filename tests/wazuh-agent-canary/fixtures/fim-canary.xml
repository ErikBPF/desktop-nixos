<ossec_config>
  <rootcheck><disabled>yes</disabled></rootcheck>
  <syscheck>
    <disabled>no</disabled>
    <frequency>3600</frequency>
    <scan_on_start>yes</scan_on_start>
    <directories realtime="yes" check_all="yes" report_changes="no" recursion_level="0">/host-fim</directories>
    <file_limit><enabled>yes</enabled><entries>8</entries></file_limit>
    <max_eps>10</max_eps>
    <synchronization><enabled>no</enabled></synchronization>
  </syscheck>
</ossec_config>
